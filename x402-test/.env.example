# ============================================================
# x402 Test Program — Environment Variables
# ============================================================
# Copia este archivo como .env y rellena los valores reales.
#
# Prerequisitos:
#   - Wallet del BUYER con USDC testnet en Avalanche Fuji
#   - Wallet del SELLER para recibir pagos
#   - Facilitador OpenZeppelin Relayer corriendo con plugin x402
# ============================================================

# ===== FACILITADOR x402 =====
# URL base del facilitador OpenZeppelin Relayer con plugin x402
# (sin trailing slash, los endpoints /call/verify, /call/settle, /call/supported se agregan automáticamente)
FACILITATOR_URL=https://dot-revealable-telescopically.ngrok-free.dev/api/v1/plugins/x402/call
FACILITATOR_API_KEY=
# ===== SELLER (Python FastAPI) =====
# Dirección de wallet que RECIBE los pagos (checksummed, con prefijo 0x)
SELLER_WALLET_ADDRESS=0xYOUR_SELLER_WALLET_ADDRESS_HERE
# Puerto del servidor seller
SELLER_PORT=4021

# ===== BUYER (Node.js TypeScript) =====
# Private key de la wallet que PAGA (con prefijo 0x)
# IMPORTANTE: esta wallet debe tener USDC testnet en Avalanche Fuji
BUYER_PRIVATE_KEY=0xYOUR_BUYER_PRIVATE_KEY_HERE
# URL completa del servidor seller (debe coincidir con SELLER_PORT)
SELLER_URL=http://localhost:4021
